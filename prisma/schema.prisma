generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  PARTNER
  ADMIN
  ACCOUNTANT
}

enum CardType {
  credit
  debit
}

enum OwnershipType {
  business
  personal
}

enum PaymentMethod {
  card
  cash
  bank_transfer
  check
}

enum ExpenseStatus {
  draft
  pending
  processed
  approved
  rejected
}

enum CategoryGroup {
  renovation
  tools
  vehicle
  operations
  technology
  marketing
  tax
  other
}

enum ReportType {
  monthly
  partner
  card
  vendor
  category
  tax
  annual
}

enum ReportFormat {
  pdf
  excel
  csv
}

enum OCRProvider {
  google_vision
  aws_textract
  openai
  local
}

model User {
  id             String         @id @default(cuid())
  name           String         @unique
  email          String?        @unique
  pinHash        String
  role           UserRole       @default(PARTNER)
  rememberDevice Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  cards          Card[]
  expensesUploaded Expense[]    @relation("UploadedBy")
  expensesOwned  Expense[]       @relation("ExpenseOwner")
  sessions       UserSession[]
  uploads        Upload[]
  activityLogs   ActivityLog[]
  reports        Report[]
  expenseRules   ExpenseRule[]
  monthlySummariesCreated MonthlySummary[]
  expenseApprovals Expense[]    @relation("ApprovedBy")
  approvals      ExpenseApproval[]
}

model UserSession {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String
  deviceLabel String?
  ipAddress   String?
  userAgent   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  lastUsedAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id          String         @id @default(cuid())
  name        String         @unique
  slug        String         @unique
  group       CategoryGroup
  color       String         @default("#d79a12")
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  expenses     Expense[]
  expenseItems ExpenseItem[]
  vendors      Vendor[]
  expenseRules ExpenseRule[]
}

model Vendor {
  id              String      @id @default(cuid())
  name            String
  normalizedName  String      @unique
  categoryId      String?
  category        Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  totalSpend      Decimal     @default(0) @db.Decimal(12, 2)
  purchaseCount   Int         @default(0)
  lastSeenAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  expenses        Expense[]

  @@index([categoryId])
}

model Card {
  id             String         @id @default(cuid())
  cardName       String
  bank           String
  type           CardType
  ownership      OwnershipType
  ownerId        String
  last4          String
  color          String         @default("#d79a12")
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  owner          User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  expenses       Expense[]
  expenseRules   ExpenseRule[]

  @@index([ownerId])
  @@index([ownership])
  @@index([type])
}

model Expense {
  id               String         @id @default(cuid())
  sourceHash       String?        @unique
  uploadedById     String
  expenseOwnerId   String
  vendorId         String?
  categoryId       String?
  cardId           String?
  approvedById     String?
  vendorName       String
  date             DateTime
  time             String?
  address          String?
  phone            String?
  subtotal         Decimal        @db.Decimal(12, 2)
  tax              Decimal        @default(0) @db.Decimal(12, 2)
  amount           Decimal        @db.Decimal(12, 2)
  currency         String         @default("CAD")
  items            ExpenseItem[]
  businessPersonal OwnershipType  @default(business)
  paymentMethod    PaymentMethod  @default(card)
  paidByLabel      String
  receiptExists    Boolean        @default(true)
  visibleTo        String[]       @default([])
  status           ExpenseStatus  @default(processed)
  confidenceScore  Float          @default(0)
  ocrText          String?
  ocrData          Json?
  aiData           Json?
  notes            String?
  duplicateOfId    String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  uploadedBy       User           @relation("UploadedBy", fields: [uploadedById], references: [id], onDelete: Cascade)
  expenseOwner     User           @relation("ExpenseOwner", fields: [expenseOwnerId], references: [id], onDelete: Cascade)
  approvedBy       User?          @relation("ApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  vendor           Vendor?        @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  category         Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  card             Card?          @relation(fields: [cardId], references: [id], onDelete: SetNull)
  uploads          Upload[]
  approvals        ExpenseApproval[]
  logs             ActivityLog[]

  @@index([uploadedById])
  @@index([expenseOwnerId])
  @@index([vendorId])
  @@index([categoryId])
  @@index([cardId])
  @@index([date])
}

model ExpenseItem {
  id          String   @id @default(cuid())
  expenseId   String
  name        String
  quantity    Float?   @default(1)
  unitPrice   Decimal? @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  categoryId  String?
  createdAt   DateTime @default(now())
  expense     Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([expenseId])
}

model Upload {
  id             String    @id @default(cuid())
  expenseId      String?
  userId         String
  originalName   String
  fileName       String
  mimeType       String
  storageKey     String
  thumbnailKey   String?
  fileSize       Int
  sha256         String    @unique
  pageCount      Int?
  width          Int?
  height         Int?
  createdAt      DateTime  @default(now())
  expense        Expense?  @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ocrJobs        OCRJob[]

  @@index([userId])
  @@index([expenseId])
}

model OCRJob {
  id            String       @id @default(cuid())
  uploadId      String
  provider      OCRProvider   @default(local)
  status        ExpenseStatus @default(draft)
  rawText       String?
  structuredData Json?
  confidence    Float        @default(0)
  errorMessage  String?
  attempts      Int          @default(0)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  upload        Upload       @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([uploadId])
  @@index([status])
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  action      String
  entityType  String?
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expense     Expense? @relation(fields: [entityId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
}

model Report {
  id          String       @id @default(cuid())
  type        ReportType
  format      ReportFormat
  periodStart DateTime
  periodEnd   DateTime
  generatedById String
  fileUrl     String?
  fileKey     String?
  data        Json
  createdAt   DateTime     @default(now())
  generatedBy User         @relation(fields: [generatedById], references: [id], onDelete: Cascade)

  @@index([generatedById])
  @@index([type])
  @@index([periodStart, periodEnd])
}

model ExpenseRule {
  id          String   @id @default(cuid())
  name        String
  vendorPattern String
  categoryId  String?
  ownerId     String?
  cardId      String?
  condition   Json?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  owner       User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  card        Card?     @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@index([vendorPattern])
  @@index([ownerId])
}

model ExpenseApproval {
  id            String       @id @default(cuid())
  expenseId     String
  approverId    String
  status        ExpenseStatus @default(pending)
  note          String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  expense       Expense      @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  approver      User         @relation(fields: [approverId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@index([approverId])
}

model MonthlySummary {
  id                String   @id @default(cuid())
  year              Int
  month             Int
  totalAmount       Decimal  @db.Decimal(12, 2)
  taxAmount         Decimal  @db.Decimal(12, 2)
  materialAmount    Decimal  @db.Decimal(12, 2)
  toolAmount        Decimal  @db.Decimal(12, 2)
  fuelAmount        Decimal  @db.Decimal(12, 2)
  mealsAmount       Decimal  @db.Decimal(12, 2)
  officeAmount      Decimal  @db.Decimal(12, 2)
  softwareAmount    Decimal  @db.Decimal(12, 2)
  marketingAmount   Decimal  @db.Decimal(12, 2)
  miscAmount        Decimal  @db.Decimal(12, 2)
  businessCardAmount Decimal @db.Decimal(12, 2)
  personalCardAmount Decimal @db.Decimal(12, 2)
  createdById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([year, month])
  @@index([createdById])
}
